# ── Secrets — never commit ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── SQLite (including WAL journal files) ──────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
myvenv/
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Investigation output (runtime artifacts, not source) ──────────────────
output/
data/
logs/

# ── Temp / scratch files ──────────────────────────────────────────────────
*.tmp
*.log
*.bak

# ── Presentation / document exports (generated, not source) ──────────────
slide-*.jpg
slide-*.png
*.pdf
*.pptx
*.docx
*.xlsx

# ── Frontend ──────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
