# ── LLM API (one of these is required) ───────────────────────────────────────
# Hackathon: use AIML_API_KEY (claim $10 credits at lablab.ai → AI/ML API coupon)
# Local dev: use ANTHROPIC_API_KEY directly
AIML_API_KEY=                       # from aimlapi.com — hackathon credits
ANTHROPIC_API_KEY=                  # direct Anthropic (fallback / local dev)

# ── SAGE passthrough ──────────────────────────────────────────────────────────
NVD_API_KEY=                        # optional but recommended (free: nvd.nist.gov/developers/request-an-api-key)
GITHUB_TOKEN=                       # optional — needed for PR creation
GITHUB_REPO=                        # optional — auto-detected from scanned repo's git remote

# ── Band connection ───────────────────────────────────────────────────────────
BAND_REST_URL=https://app.band.ai/
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# ── Band agent credentials ────────────────────────────────────────────────────
# Create each agent at app.band.ai → Agents → New Agent (Remote Agent)
# Copy UUID from agent settings page, API key from creation screen (shown once)

THREAT_AGENT_ID=
THREAT_AGENT_KEY=

STATIC_AGENT_ID=
STATIC_AGENT_KEY=

EXPLOITABILITY_AGENT_ID=
EXPLOITABILITY_AGENT_KEY=

CHALLENGER_AGENT_ID=
CHALLENGER_AGENT_KEY=

REMEDIATION_AGENT_ID=
REMEDIATION_AGENT_KEY=

COMPLIANCE_AGENT_ID=
COMPLIANCE_AGENT_KEY=

VERIFICATION_AGENT_ID=
VERIFICATION_AGENT_KEY=

PR_AGENT_ID=
PR_AGENT_KEY=
